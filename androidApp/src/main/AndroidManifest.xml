<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Test host only. No UI, no launcher activity, no Firebase SDK.
      Bluetooth permissions are declared because the transport work in v0.9 needs
      them; nothing in this build uses them yet.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application android:label="insnaps test host" android:allowBackup="false" />
</manifest>
